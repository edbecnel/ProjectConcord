<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Edf.Desktop.ViewModels"
        mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="520"
        x:Class="Edf.Desktop.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ProjectConcord"
        Width="720" Height="900"
        MinWidth="560" MinHeight="400">
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="File">
        <NativeMenu>
          <NativeMenuItem Header="Open Project Folder…"
                          Click="FileOpenProjectFolder_OnClick" />
          <NativeMenuItem Header="Go to Folder…"
                          Click="FileGoToFolder_OnClick" />
        </NativeMenu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16">
      <TextBlock Text="ProjectConcord"
                 FontSize="20"
                 FontWeight="SemiBold" />
      <TextBlock Text="{Binding ActorDisplayName, StringFormat=Actor: {0}}" />

      <Border Padding="12" CornerRadius="4" BorderThickness="1" BorderBrush="#CCC">
        <StackPanel Spacing="8">
          <TextBlock Text="Active project" FontWeight="SemiBold" />
          <TextBlock Text="No project open."
                     IsVisible="{Binding !HasActiveProject}" />
          <StackPanel Spacing="6" IsVisible="{Binding HasActiveProject}">
            <TextBlock Text="{Binding CurrentProjectId, StringFormat=Project ID: {0}}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0"
                       Text="{Binding ProjectRootPath}"
                       IsReadOnly="True"
                       TextWrapping="Wrap"
                       MinHeight="32" />
              <Button Grid.Column="1"
                      Margin="8,0,0,0"
                      Content="Copy path"
                      Command="{Binding CopyActivePathCommand}"
                      VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Open project folder…"
                    Command="{Binding OpenProjectFolderCommand}" />
            <Button Content="Close Project"
                    Command="{Binding CloseProjectCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Text="Recent Projects" FontWeight="SemiBold" />
      <TextBlock Text="{Binding RecentEmptyMessage}"
                 IsVisible="{Binding !HasRecentProjects}"
                 TextWrapping="Wrap"
                 Foreground="Gray" />

      <ItemsControl ItemsSource="{Binding RecentProjects}"
                    IsVisible="{Binding HasRecentProjects}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RecentProjectItemViewModel">
            <Border Margin="0,0,0,8" Padding="12" CornerRadius="4" BorderThickness="1" BorderBrush="#DDD">
              <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                  <TextBlock Text="Last active"
                             IsVisible="{Binding IsLastActive}"
                             FontSize="11"
                             Foreground="#0066CC" />
                  <TextBlock Text="{Binding AvailabilityLabel}"
                             FontSize="11"
                             Foreground="DarkOrange"
                             IsVisible="{Binding IsMissingOnDisk}" />
                  <TextBlock Text="{Binding AvailabilityLabel}"
                             FontSize="11"
                             Foreground="Gray"
                             IsVisible="{Binding !IsMissingOnDisk}" />
                </StackPanel>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Grid.Column="0"
                           Text="{Binding LocatorPath}"
                           IsReadOnly="True"
                           FontSize="12"
                           TextWrapping="Wrap"
                           MinHeight="28" />
                  <Button Grid.Column="1"
                          Margin="8,0,0,0"
                          Content="Copy path"
                          Command="{Binding CopyLocatorPathCommand}"
                          VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="{Binding LastOpenedLabel, StringFormat=Last opened: {0}}" FontSize="11" Foreground="Gray" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Open"
                          Command="{Binding OpenCommand}" />
                  <Button Content="Relocate Project…"
                          Command="{Binding RelocateCommand}" />
                  <Button Content="Remove from Recent"
                          Command="{Binding RemoveFromRecentCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="{Binding StatusMessage}"
                 Foreground="Gray"
                 TextWrapping="Wrap" />

      <Border Padding="12" CornerRadius="4" BorderThickness="1" BorderBrush="#CCC"
              IsVisible="{Binding Relay, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Spacing="10" DataContext="{Binding Relay}">
          <TextBlock Text="Governed relay (P0 manual)" FontWeight="SemiBold" />
          <TextBlock Text="{Binding AuthorizationBoundaryNotice}" TextWrapping="Wrap" FontSize="12" Foreground="Gray" />
          <TextBlock Text="{Binding SessionIntentHint}" TextWrapping="Wrap" FontSize="12" Foreground="Gray" />
          <TextBlock Text="Open a project to enable relay workflow."
                     IsVisible="{Binding !IsRelaySectionEnabled}"
                     Foreground="DarkOrange"
                     TextWrapping="Wrap" />

          <Grid ColumnDefinitions="*,*" IsVisible="{Binding IsRelaySectionEnabled}">
            <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,8,0">
              <TextBlock Text="Project Architect session" FontWeight="SemiBold" />
              <ComboBox ItemsSource="{Binding SessionIntentOptions}"
                        SelectedItem="{Binding ProjectArchitectSessionIntent}"
                        PlaceholderText="Select NEW or CONTINUE" />
              <TextBlock Text="Engineering Agent session" FontWeight="SemiBold" />
              <ComboBox ItemsSource="{Binding SessionIntentOptions}"
                        SelectedItem="{Binding EngineeringAgentSessionIntent}"
                        PlaceholderText="Select NEW or CONTINUE" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,0,0">
              <TextBlock Text="Engineering Agent mode" FontWeight="SemiBold" />
              <ComboBox ItemsSource="{Binding EngineeringAgentModeOptions}"
                        SelectedItem="{Binding EngineeringAgentMode}" />
              <TextBlock Text="Prior Engineering Agent mode (optional)" FontWeight="SemiBold" />
              <ComboBox ItemsSource="{Binding PriorEngineeringAgentModeOptions}"
                        SelectedItem="{Binding PriorEngineeringAgentMode}" />
            </StackPanel>
          </Grid>

          <TextBlock Text="PA review export" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Generate PA review package"
                    Command="{Binding GeneratePaReviewCommand}" />
            <Button Content="Copy PA review"
                    Command="{Binding CopyPaReviewCommand}" />
          </StackPanel>
          <TextBlock Text="{Binding PaReviewValidationSummary}" TextWrapping="Wrap" />
          <TextBox Text="{Binding PaReviewRendered}"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   MinHeight="80"
                   PlaceholderText="Generated PA review package appears here" />

          <TextBlock Text="PA handover import" FontWeight="SemiBold" />
          <TextBox Text="{Binding PaImportText}"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   MinHeight="80"
                   PlaceholderText="Paste Project Architect handover response" />
          <Button Content="Import PA handover"
                  HorizontalAlignment="Left"
                  Command="{Binding ImportPaHandoverCommand}" />
          <TextBlock Text="{Binding PaImportValidationSummary}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding EngineeringHandoverStatus}" TextWrapping="Wrap" Foreground="#0066CC" />

          <TextBlock Text="Engineering Agent handover" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Prepare Engineering Agent handover"
                    Command="{Binding PrepareEngineeringHandoverCommand}" />
            <Button Content="Copy Engineering Agent handover"
                    Command="{Binding CopyEngineeringHandoverCommand}" />
          </StackPanel>
          <TextBox Text="{Binding EngineeringHandoverRendered}"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   MinHeight="80"
                   PlaceholderText="Prepared handover appears here when Valid and actionable" />

          <TextBlock Text="Engineering result import (optional)" FontWeight="SemiBold" />
          <TextBox Text="{Binding EngineeringResultText}"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   MinHeight="60"
                   PlaceholderText="Paste thin engineering result relay text" />
          <Button Content="Import engineering result"
                  HorizontalAlignment="Left"
                  Command="{Binding ImportEngineeringResultCommand}" />
          <TextBlock Text="{Binding EngineeringResultValidationSummary}" TextWrapping="Wrap" />

          <TextBlock Text="Validation diagnostics" FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding Diagnostics}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="Recent provenance (PC-PAR-021)" FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding ProvenanceEvents}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RelayProvenanceItemViewModel">
                <TextBlock Text="{Binding DisplayLine}" FontSize="11" Foreground="Gray" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="{Binding RelayStatusMessage}" Foreground="Gray" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Window>
